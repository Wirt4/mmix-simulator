<div class="editor-input-wrapper">
  <div data-ide-facade-target="editorContainer"></div>
  <%= form.text_area :source,
      hidden: true,
      data: {
        ide_facade_target: "textarea",
        action: "input->ide-facade#sourceEdited"
        },
    spellcheck: false,
    autocomplete: "off",
    autocorrect: "off",
    autocapitalize: "off"
  %>
</div>
