    mockModule.HEAPU8 = mockHeap
    vi.spyOn(mockModule, '_get_stdout_size').mockReturnValue(encoded.length)
    vi.spyOn(mockModule, '_get_stdout_pointer').mockReturnValue(mockPtr)

